<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8">

    <!-- Título de la pantalla -->
    <TextView
        android:id="@+id/txtTituloDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:text="Detalle del movimiento"
        android:textColor="#174C49"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tarjeta con la información del movimiento -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tarjetaDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:contentPadding="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloDetalle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Concepto -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Concepto"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtConceptoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#174C49"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Compra de materiales" />

            <!-- Importe -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Importe"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtImporteDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#D96C63"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="- Q 25.50" />

            <!-- Tipo de movimiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Tipo de movimiento"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTipoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#174C49"
                android:textSize="16sp"
                tools:text="Gasto" />

            <!-- Moneda -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Moneda"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtMonedaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#174C49"
                android:textSize="16sp"
                tools:text="GTQ - Quetzales" />

            <!-- Fecha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Fecha del movimiento"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtFechaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#174C49"
                android:textSize="16sp"
                tools:text="26/10/2026" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- Botón para editar el movimiento seleccionado -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditarMovimiento"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="Editar movimiento"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#147D70"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/tarjetaDetalle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Botón para eliminar el movimiento seleccionado -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEliminarMovimiento"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:text="Eliminar movimiento"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#D96C63"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/btnEditarMovimiento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
