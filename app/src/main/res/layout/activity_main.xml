<?xml version="1.0" encoding="utf-8"?>

<!-- Permite desplazar la pantalla verticalmente -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F8"
    android:fillViewport="true">

    <!-- Contenedor que organiza los elementos de la pantalla -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".MainActivity">

    <!-- Nombre principal de la aplicación -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:text="MiControlFinanciero"
        android:textColor="#174C49"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Descripción de la pantalla principal -->
    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="Control de ingresos y gastos"
        android:textColor="#64748B"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Tarjeta que mostrará el saldo en quetzales -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tarjetaSaldoGTQ"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#E5F3F0"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Organiza los textos uno debajo del otro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Etiqueta descriptiva del saldo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Balance en quetzales"
                android:textColor="#456A67"
                android:textSize="14sp" />

            <!-- Cantidad del saldo -->
            <TextView
                android:id="@+id/txtSaldoGTQ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Q 0.00"
                android:textColor="#174C49"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- Tarjeta que mostrará el saldo en dólares -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tarjetaSaldoUSD"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tarjetaSaldoGTQ"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Descripción del saldo en dólares -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Balance en dólares"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- Cantidad en dólares -->
            <TextView
                android:id="@+id/txtSaldoUSD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="$ 0.00"
                android:textColor="#174C49"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta que mostrará el saldo en euros -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tarjetaSaldoEUR"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tarjetaSaldoUSD"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Descripción del saldo en euros -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Balance en euros"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- Cantidad en euros -->
            <TextView
                android:id="@+id/txtSaldoEUR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="€ 0.00"
                android:textColor="#174C49"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

        <!-- Botón para registrar un nuevo ingreso -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarIngreso"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:text="Registrar ingreso"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#147D70"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/tarjetaSaldoEUR"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón para registrar un nuevo gasto -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarGasto"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:text="Registrar gasto"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D96C63"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/btnRegistrarIngreso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



        <!-- Botón para consultar el historial -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerHistorial"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:text="Ver historial"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#174C49"
            android:backgroundTint="#E2F1EE"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/btnRegistrarGasto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Botón para consultar el resumen financiero -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerResumen"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:text="Ver resumen financiero"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#174C49"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/btnVerHistorial"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>